# Copier ce fichier en .env et renseigner de vraies valeurs en local.

# Connexion PostgreSQL (schema.sql doit déjà avoir été appliqué sur cette base)
DATABASE_URL="postgresql://gera_app:changeme@localhost:5432/gera_dev?schema=public"

# Secrets JWT — access court + refresh rotatif (cf. cahier des charges, Partie 3)
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Stockage objet (cahier des charges, Partie 3 : "S3-compatible, un préfixe
# par organisation, URLs signées") — laisser S3_BUCKET vide en local : un
# backend disque local (api/uploads/, signé par HMAC) prend le relais
# automatiquement, cf. api/src/lib/storage.ts. En production, renseigner :
# S3_BUCKET="gera-documents"
# S3_REGION="auto"                      # "auto" pour R2 ; une vraie région AWS sinon
# S3_ENDPOINT="https://xxx.r2.cloudflarestorage.com"  # absent = AWS S3 standard
# S3_FORCE_PATH_STYLE="true"            # requis par certains fournisseurs S3-compatibles (MinIO...)
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# API_PUBLIC_URL="https://api.example.com"  # base des URLs signées en mode disque local uniquement
