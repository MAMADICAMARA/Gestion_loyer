# Copier ce fichier en .env et renseigner de vraies valeurs en local.

# Connexion PostgreSQL (schema.sql doit déjà avoir été appliqué sur cette base)
DATABASE_URL="postgresql://gera_app:changeme@localhost:5432/gera_dev?schema=public"

# Secrets JWT — access court + refresh rotatif (cf. cahier des charges, Partie 3)
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
WEB_ORIGIN="http://localhost:3000"
